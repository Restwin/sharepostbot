# Bot
BOT_TOKEN=1234567890:AAAAAVVVVVSAKBKBALDL
BOT_NAME=sharepostbot
MAIN_CHANNEL_ID=-1000000000000
# Optional: topic (forum thread) in the main channel to post into. 0 = General / non-forum.
MAIN_CHANNEL_THREAD_ID=0
# Super-admin user IDs (numeric, comma-separated). Bootstrap list — these users
# are always STAFF regardless of DB state. The first admin must be set here.
ADMIN_IDS=111111111,222222222

# IMPORTANT: disable privacy mode via @BotFather (/setprivacy → Disable)
# so the bot receives ALL messages in groups (needed for album reposting
# via reply+mention). Without this, the bot only sees commands/mentions/replies
# and album items are never cached.

# Tech chat: chat IDs that receive critical events (errors, admin audit,
# business/system events) and the /backup_db file. Comma-separated.
# Empty = only the /backup_db fallback: the file goes to the caller's chat.
DEBUG_INFO_CHAT_IDS=

# Webhook (leave WEBHOOK_URL empty to use long polling)
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8080
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_PUBLIC_URL=https://your.public.host

# Database
DB_PATH=./data/database.sqlite

# Automatic local backups: rotating snapshots of the SQLite DB (VACUUM INTO),
# stored in BACKUP_DIR next to the DB. Nothing is sent to Telegram —
# /backup_db remains for manual offsite copies.
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Logging
# LOG_LEVEL: DEBUG (dev, shows every update + handlers) | INFO (prod, events only) | WARNING | ERROR
# LOG_JSON: true for production (JSON to stderr) | false for pretty console
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_JSON=true
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# Tech-chat filter (only used when DEBUG_INFO_CHAT_IDS is set):
# events at or above LOG_CHAT_LEVEL are forwarded automatically;
# LOG_CHAT_EVENTS lists enabled categories: errors,system,admin,business.
LOG_CHAT_LEVEL=ERROR
LOG_CHAT_EVENTS=errors,system,admin,business

# HTTP control API (health, version, etc.)
# HTTP_API_PASSWORD: Bearer token for /ready, /version. Empty = dev (no auth).
#   /health is ALWAYS open (liveness probe for Docker HEALTHCHECK).
HTTP_HOST=127.0.0.1
HTTP_PORT=8081
HTTP_API_PASSWORD=change-me-to-a-long-random-string

# Features
PROTECT_CONTENT=false
# Extra trigger phrases (besides the @mention) that trigger reposting when a
# user replies with them in a source chat. Case-insensitive, comma-separated.
REPOST_TRIGGER_PHRASES=в движухи
# Custom emoji ID shown in the corner of the community link buttons
# ("Правила публикации постов", "Канал", "Основной чат") in the inline menu.
# Leave empty to disable. Requires a valid custom emoji ID (a document_id
# string, e.g. from a custom emoji sticker set) and only works if the bot
# owner has Telegram Premium (messages to private/group/supergroup chats) or
# the bot purchased additional usernames on Fragment.
LINK_ICON_CUSTOM_EMOJI_ID=

# Pagination page sizes for the inline-menu lists (users / chats).
# Independent on purpose: users sorted by last activity, chats by name.
LIST_PAGE_USERS=20
LIST_PAGE_CHATS=20

# API session (retry on transient network errors)
# Useful with unstable connectivity to api.telegram.org
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY=0.5
